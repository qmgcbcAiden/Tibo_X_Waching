# X profile and resilient anonymous sources (no account login is used)
X_HANDLE=thsottiaux
POLL_MIN_SECONDS=180
POLL_MAX_SECONDS=300
BACKFILL_HOURS=24
# Keep the browser source as a best-effort low-latency path.
X_BROWSER_ENABLED=true
# Feedly currently proxies the same XCancel feed without a login or API token.
X_FEEDLY_ENABLED=true
X_FEEDLY_STREAM_URL=https://cloud.feedly.com/v3/streams/contents?streamId=feed%2Fhttps%3A%2F%2Frss.xcancel.com%2Fthsottiaux%2Frss&count=20
# Turn this on after XCancel confirms the reader ID has been whitelisted.
X_XCANCEL_RSS_ENABLED=false
X_XCANCEL_RSS_URL=https://rss.xcancel.com/thsottiaux/rss
X_RSS_USER_AGENT=TiboWatch-RSS/1.0

# OpenAI-compatible DeepSeek endpoint
DEEPSEEK_BASE_URL=https://your-deepseek-endpoint.example/v1
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Flash writes the first draft; Pro is reserved for unsafe or unparseable output.
COPY_DRAFT_MODEL=deepseek-v4-flash
COPY_REPAIR_MODEL=deepseek-v4-pro
# Legacy compatibility alias. COPY_REPAIR_MODEL takes precedence when set.
DEEPSEEK_COPY_MODEL=deepseek-v4-pro
COPY_DRAFT_MAX_TOKENS=4096
COPY_MAX_TOKENS=16384
COPY_DIGEST_MAX_TOKENS=24576
COPY_REQUEST_TIMEOUT_MS=300000

# First-start bootstrap administrator. Add ordinary users later with the local CLI.
# Existing SQLite user data takes precedence after the first successful start.
SERVERCHAN_TARGETS_JSON=[{"name":"owner","sendKey":"SCT_REPLACE_OWNER","role":"maintainer"}]
OVERFLOW_DIGEST_TIME=23:50

TZ=Asia/Shanghai
DATA_DIR=/app/data
# X currently rejects Chromium's true headless mode. Docker runs headed Chromium inside Xvfb.
HEADLESS=false
REQUEST_TIMEOUT_MS=30000
HEALTHCHECK_MAX_AGE_MS=1200000

# Low-resource administration GUI. Point this domain to the VPS before launch.
ADMIN_ENABLED=true
ADMIN_DOMAIN=tibo-watch.example.com
ADMIN_USERNAME=admin
# Generate with: docker compose run --rm watcher node dist/src/cli.js admin-hash
# Keep the single quotes so Compose does not interpolate the hash's $ separators.
ADMIN_PASSWORD_HASH='scrypt$REPLACE_WITH_GENERATED_HASH'
ADMIN_INTERNAL_PORT=8787
ADMIN_SESSION_HOURS=12
ADMIN_TRACE_RETENTION_DAYS=30
PROBE_RETENTION_DAYS=7
